APP_NAME=KrishiSetu API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000
DEMO_OTP_ENABLED=true
DEMO_LOGIN_ENABLED=true
